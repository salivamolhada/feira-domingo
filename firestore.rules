rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User scope: Each user has their own isolated subcollections for sales, customers, products, and expenses
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /sales/{saleId} {
        allow read, write: if isOwner(userId) && isValidId(saleId);
      }

      match /customers/{customerId} {
        allow read, write: if isOwner(userId) && isValidId(customerId);
      }

      match /products/{productId} {
        allow read, write: if isOwner(userId) && isValidId(productId);
      }

      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId) && isValidId(expenseId);
      }
    }
  }
}
